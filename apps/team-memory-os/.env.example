# Production is the default (unset = prod). Set AIFACTORY_DEV=1 ONLY on a laptop — never in a deployed .env.
AIFACTORY_PROD=1
MEMORY_MARKET_URL=http://localhost:8810
MEMORY_MARKET_API_KEY=replace-with-memory-market-api-key
SAAS_GATEWAY_URL=http://localhost:9400
SAAS_GATEWAY_API_KEY=replace-with-gateway-service-key
