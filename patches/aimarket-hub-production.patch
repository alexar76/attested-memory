+import pytest
+
+from aimarket_hub.storage import assert_production_postgres
+
+
+DSNS = (
+    "DATABASE_URL", "AIMARKET_CHANNELS_DATABASE_URL", "AIMARKET_SANDBOX_DATABASE_URL",
+    "AIMARKET_ACEX_IPO_DATABASE_URL", "AIMARKET_ACEX_AUDIT_DATABASE_URL",
+    "AIMARKET_ZK_DATABASE_URL", "AIMARKET_ESCROW_DATABASE_URL", "AIFACTORY_DATABASE_URL",
+)
+
+
+def configure_secure_production(monkeypatch):
+    monkeypatch.setenv("AIFACTORY_PROD", "1")
+    for name in DSNS:
+        monkeypatch.setenv(name, "postgresql://user:secret@db/app")
+    for name in ("AIMARKET_CAPABILITY_TOKEN", "AIMARKET_ADMIN_TOKEN", "AIMARKET_TEAM_AUTH_SECRET"):
+        monkeypatch.setenv(name, "x" * 32)
+    monkeypatch.setenv("AIMARKET_PUBLISHER_TOKENS", "memory-market:" + "y" * 32)
+    monkeypatch.setenv("AIMARKET_PQC_REQUIRE", "1")
+    monkeypatch.setenv("AIMARKET_SUPPLY_REQUIRE_RESPONSE_SIG", "1")
+    for name in (
+        "AIMARKET_SUPPLY_SECURITY_RELAXED", "AIMARKET_SANDBOX_STUB_INVOKE",
+        "AIMARKET_ZK_SIMULATED", "AIMARKET_TEE_SOFTWARE_OK",
+        "AIFACTORY_PAYMENT_VERIFY_STUB", "AIFACTORY_PAYMENT_TESTNET",
+    ):
+        monkeypatch.setenv(name, "0")
+
+
+def test_secure_production_profile_is_accepted(monkeypatch):
+    configure_secure_production(monkeypatch)
+    assert_production_postgres()
+
+
+def test_sqlite_and_relaxed_security_are_rejected(monkeypatch):
+    configure_secure_production(monkeypatch)
+    monkeypatch.setenv("AIMARKET_ZK_DATABASE_URL", "sqlite:///unsafe.db")
+    with pytest.raises(RuntimeError, match="PostgreSQL DSNs"):
+        assert_production_postgres()
+
+    configure_secure_production(monkeypatch)
+    monkeypatch.delenv("AIFACTORY_DATABASE_URL")
+    with pytest.raises(RuntimeError, match="AIFACTORY_DATABASE_URL"):
+        assert_production_postgres()
+
+    configure_secure_production(monkeypatch)
+    monkeypatch.setenv("AIMARKET_SUPPLY_SECURITY_RELAXED", "1")
+    with pytest.raises(RuntimeError, match="unsafe development flags"):
+        assert_production_postgres()
+
+    configure_secure_production(monkeypatch)
+    monkeypatch.delenv("AIFACTORY_PAYMENT_TESTNET")
+    with pytest.raises(RuntimeError, match="must be explicitly disabled"):
+        assert_production_postgres()
+
+
+def test_local_publish_requires_safe_gateway_allowlist(monkeypatch):
+    configure_secure_production(monkeypatch)
+    monkeypatch.setenv("AIMARKET_ALLOW_LOCAL_PUBLISH", "1")
+    monkeypatch.setenv("AIMARKET_INVOKE_HOST_GATEWAY", "memory-market,*")
+    with pytest.raises(RuntimeError, match="safe AIMARKET_INVOKE_HOST_GATEWAY"):
+        assert_production_postgres()
+
+
+def test_operator_publishers_require_a_publisher_credential(monkeypatch):
+    configure_secure_production(monkeypatch)
+    monkeypatch.setenv("AIMARKET_SUPPLY_OPERATOR_PUBLISHERS", "unknown-provider")
+    with pytest.raises(RuntimeError, match="operator publishers require"):
+        assert_production_postgres()
