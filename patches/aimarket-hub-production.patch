+from pathlib import Path
+
+from aimarket_hub.db_backend import DBBackend, create_backend
+
+
+def service_database_url(env_name: str) -> str:
+    """Resolve a subsystem DSN, falling back to the hub DSN for local installs."""
+    return (os.getenv(env_name) or os.getenv("DATABASE_URL") or "").strip()
+
+
+def service_backend(db_path: str | Path, env_name: str) -> DBBackend:
+    return create_backend(database_url=service_database_url(env_name), db_path=db_path)
+
+
+def _truthy(name: str, default: str = "") -> bool:
+    return os.getenv(name, default).strip().lower() in {"1", "true", "yes"}
+
+
+def _require_secret(name: str) -> None:
+    if len(os.getenv(name, "").strip()) < 32:
+        raise RuntimeError(f"{name} must be a random 32+ character secret")
+
+
+def assert_production_postgres() -> None:
+    if _truthy("AIFACTORY_PROD"):
+        names = (
+            "DATABASE_URL", "AIMARKET_CHANNELS_DATABASE_URL", "AIMARKET_SANDBOX_DATABASE_URL",
+            "AIMARKET_ACEX_IPO_DATABASE_URL", "AIMARKET_ACEX_AUDIT_DATABASE_URL",
+            "AIMARKET_ZK_DATABASE_URL", "AIMARKET_ESCROW_DATABASE_URL",
+            "AIFACTORY_DATABASE_URL",
+        )
+        missing = [name for name in names if not os.getenv(name, "").strip()]
+        non_pg = [name for name in names if os.getenv(name, "").strip()
+                  and not os.getenv(name, "").strip().startswith(("postgresql://", "postgres://"))]
+        if missing or non_pg:
+            detail = ", ".join(missing + non_pg)
+            raise RuntimeError(f"production requires PostgreSQL DSNs for every Hub store: {detail}")
+        for name in ("AIMARKET_CAPABILITY_TOKEN", "AIMARKET_ADMIN_TOKEN", "AIMARKET_TEAM_AUTH_SECRET"):
+            _require_secret(name)
+        publisher_tokens = os.getenv("AIMARKET_PUBLISHER_TOKENS", "").split(",")
+        if not publisher_tokens or any(
+            ":" not in item or len(item.split(":", 1)[1].strip()) < 32
+            for item in publisher_tokens
+        ):
+            raise RuntimeError("every AIMARKET_PUBLISHER_TOKENS entry must contain a 32+ character secret")
+        publisher_ids = {item.split(":", 1)[0].strip() for item in publisher_tokens}
+        operator_publishers = {
+            item.strip() for item in os.getenv("AIMARKET_SUPPLY_OPERATOR_PUBLISHERS", "").split(",")
+            if item.strip()
+        }
+        unknown_operator_publishers = operator_publishers - publisher_ids
+        if unknown_operator_publishers:
+            raise RuntimeError(
+                "operator publishers require their own AIMARKET_PUBLISHER_TOKENS entry: "
+                + ", ".join(sorted(unknown_operator_publishers))
+            )
+        if not _truthy("AIMARKET_PQC_REQUIRE", "1"):
+            raise RuntimeError("AIMARKET_PQC_REQUIRE cannot be disabled in production")
+        if not _truthy("AIMARKET_SUPPLY_REQUIRE_RESPONSE_SIG", "1"):
+            raise RuntimeError("provider response signatures cannot be disabled in production")
+        unsafe_flags = (
+            "AIMARKET_SUPPLY_SECURITY_RELAXED", "AIMARKET_SANDBOX_STUB_INVOKE",
+            "AIMARKET_ZK_SIMULATED", "AIMARKET_TEE_SOFTWARE_OK",
+            "AIFACTORY_PAYMENT_VERIFY_STUB",
+        )
+        enabled = [name for name in unsafe_flags if _truthy(name)]
+        if enabled:
+            raise RuntimeError("unsafe development flags are forbidden in production: " + ", ".join(enabled))
+        if _truthy("AIFACTORY_PAYMENT_TESTNET", "1"):
+            raise RuntimeError("AIFACTORY_PAYMENT_TESTNET must be explicitly disabled in production")
+        if _truthy("AIMARKET_ALLOW_LOCAL_PUBLISH"):
+            gateways = [value.strip() for value in os.getenv("AIMARKET_INVOKE_HOST_GATEWAY", "").split(",") if value.strip()]
+            if not gateways or any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?", value) for value in gateways):
