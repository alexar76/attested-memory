  server_name provenance.attestedmemory.net;
  location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
  location = /.well-known/ai-market.json  { proxy_pass http://127.0.0.1:8812; include /etc/nginx/snippets/attested-provider-proxy.conf; }
  location = /ai-market/v2/manifest       { proxy_pass http://127.0.0.1:8812; include /etc/nginx/snippets/attested-provider-proxy.conf; }
  location = /docs                        { proxy_pass http://127.0.0.1:8812; include /etc/nginx/snippets/attested-provider-proxy.conf; }
  location = /openapi.json                { proxy_pass http://127.0.0.1:8812; include /etc/nginx/snippets/attested-provider-proxy.conf; }
  location = / { return 302 https://attestedmemory.net/; }
