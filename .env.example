MEMORY_MARKET_PORT=8810
TRUTH_LAYER_PORT=8811
PROVENANCE_LEDGER_PORT=8812
AIMARKET_HUB_PORT=9084
AIMARKET_PUBLIC_HUB_URL=http://localhost:9084
AIMARKET_BOOTSTRAP_HUB_URLS=https://modelmarket.dev,https://independentai.network/hub
# Federation auto-admit: MiniMax via OpenRouter (copy from Independent hub.env).
# Without JUDGE_KEY, assay pass still needs operator Approve.
AIMARKET_FEDERATION_JUDGE_URL=https://openrouter.ai/api/v1/chat/completions
AIMARKET_FEDERATION_JUDGE_MODEL=minimax/minimax-m3
AIMARKET_FEDERATION_JUDGE_KEY=
AIMARKET_FEDERATION_ASSAY_REQUIRE=1
AIMARKET_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
MEMORY_MARKET_PUBLISHER_TOKEN=replace-with-at-least-32-random-bytes
TRUTH_LAYER_PUBLISHER_TOKEN=replace-with-at-least-32-random-bytes
PROVENANCE_PUBLISHER_TOKEN=replace-with-at-least-32-random-bytes
MEMORY_MARKET_API_KEY=replace-with-at-least-32-random-bytes
PROVENANCE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
AIMARKET_CAPABILITY_TOKEN=replace-with-at-least-32-random-bytes
POSTGRES_USER=aicom
POSTGRES_PASSWORD=replace-with-at-least-32-random-bytes
POSTGRES_DB=aicom
AIFACTORY_PROD=1
PROVENANCE_LEDGER_URL=http://provenance-ledger:8812
TRUTH_LAYER_URL=http://truth-layer:8811
# Hybrid signing and verification are mandatory in production. Classical-only
# peer manifests are rejected; pin every peer's ML-DSA key before admission.
AIMARKET_PQC_REQUIRE=1
ATTESTED_PQC_ENABLED=1
ATTESTED_PQC_REQUIRE=1
SAAS_TEAM_AUTH_SECRET=replace-with-a-long-random-value-shared-with-saas-gateway
# Direct, non-custodial settlement. Leave the recipient empty to fail closed:
# paid units remain discoverable, but checkout/order creation is disabled.
# This is a public receiving address only. Never put a private key in this file.
PAYMENT_RECIPIENT=
# Direct checkout is deliberately restricted to canonical Circle USDC on Base mainnet.
PAYMENT_CHAIN_ID=8453
PAYMENT_ASSET=USDC
PAYMENT_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Comma-separated HTTPS JSON-RPC endpoints, tried with failover.
PAYMENT_BASE_RPC_URLS=https://mainnet.base.org,https://base.drpc.org,https://gateway.tenderly.co/public/base,https://base-mainnet.public.blastapi.io
PAYMENT_MIN_CONFIRMATIONS=5
PAYMENT_ORDER_TTL_MINUTES=60
PAYMENT_LATE_GRACE_HOURS=24
PAYMENT_POLL_SECONDS=20
PAYMENT_LOG_SCAN_BLOCKS=40
PAYMENT_EXPLORER_URL=https://basescan.org
# Keep the bundled Hub's separate escrow/x402 subsystem off unless its contracts
# and verifier are deployed. Memory Market direct settlement does not need it.
AIFACTORY_CRYPTO_ENABLED=0
